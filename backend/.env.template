# ===========================================
# God's Eye Backend - Environment Configuration
# ===========================================

# --- Required API Keys ---

# Google Street View Static API Key
# https://console.cloud.google.com/ で取得
GOOGLE_STREETVIEW_API_KEY=

# Tellus API Token
# https://www.tellusxdp.com/ でアカウント作成後に取得
TELLUS_API_TOKEN=

# Roboflow API Key (建物損傷AI解析用)
# https://app.roboflow.com/ でワークスペース設定から取得
ROBOFLOW_API_KEY=

# --- Optional API Keys ---

# Meshy.ai API Key (3Dモデル生成用、オプション)
# https://www.meshy.ai/ で取得
MESHY_API_KEY=

# --- Security ---

# CORS許可オリジン (カンマ区切り)
# 本番環境では必ず設定してください
# CORS_ORIGINS=https://godseye-web.fly.dev

# 環境 (development / production)
ENVIRONMENT=development

# --- Logging ---

# ログレベル (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO
